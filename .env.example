# Google AI Studio Defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"

# Google Calendar API (OAuth 2.0 от личного аккаунта Google)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REFRESH_TOKEN="your_oauth_refresh_token"
CALENDAR_ID="primary"

# Telegram Bot API (уведомления эксперту)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRstuVWXyz"
TELEGRAM_CHAT_ID="123456789"

# Firebase Firestore (серверная авторизация через GOOGLE_APPLICATION_CREDENTIALS или Firebase project ID)
# FIREBASE_PROJECT_ID="your-firebase-project-id"
